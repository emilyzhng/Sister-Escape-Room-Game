MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1834421920}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2d2b1d9a5e4fc6a44a1fd197c007d0c5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialogue:
    sentences:
    - name: Mystery Crow
      text: "Ahoy, my dearest\u2026"
    - name: Mystery Crow
      text: "I seek for thy shiny disks\u2026ah what did you humans call them? "
    - name: 'Mystery Crow '
      text: Gold coins? bring me 3 of them and I shall grant you a treasure of my
        own. Hurry now!
    - name: Me
      text: My sister is the biggest bird-lover I've ever met
    - name: 'Me '
      text: She once told me crows are some of the smartest birds to exist. They
        stand by the saying of "you reap what you sow" so treating a crow right will
        end in them repaying you in some shape or form
    - name: 'Me '
      text: ...vice versa and your car may be pelted with bird poop!
    - name: 'Me '
      text: better go get those gold coins!
  dialogueManager: {fileID: 686127253}
