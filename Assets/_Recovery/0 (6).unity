  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialogue:
    sentences:
    - name: Me
      text: A music stand!
    - name: Me
      text: 'Cindy spent countless hours in front of this hunk of metal practicing
        her trumpet



'
    - name: Me
      text: "Uhh ohh\u2026 seems some of the notes are missing from the sheet (bars
        228 and 229)\r\n\r\n"
    - name: Me
      text: "Let\u2019s try to recover them, and complete the missing bars . . .\r\n"
  dialogueManager: {fileID: 2102714737}
